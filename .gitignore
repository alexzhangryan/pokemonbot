# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
vendor/showdown/

# Data artifacts
data/corpus.sqlite
data/corpus.sqlite-*
data/replays/
data/dex/*.json
!data/dex/.gitkeep
# The set prior is distilled from the corpus in under a second; the corpus is
# the thing worth keeping. Rebuild with `make priors`.
data/priors/
# Cached language-model replies (implementation C). Keyed by prompt; regenerated
# by re-running against Ollama. Never committed -- it can get large and is a
# derived artifact, not a source of truth.
data/llm/

# Traces and runs
runs/
traces/
*.trace.jsonl

# Models
*.pt
*.pth
checkpoints/

# Secrets
.env
config/local.*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Spartan AI config (contains API keys)
.spartan/ai.env

# Agent tooling. Configuration for how this repository is worked on rather
# than part of it, and `.claude/` in particular can hold credentials.
.agents/
.claude/
skills-lock.json
